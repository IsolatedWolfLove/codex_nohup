{
  "name": "nohop-codex",
  "version": "2.8.0-beta.2",
  "private": true,
  "homepage": "https://github.com/IsolatedWolfLove/codex_nohup",
  "description": "Persistent SSH terminal sessions for Linux and Windows",
  "type": "module",
  "scripts": {
    "dev": "node scripts/wails.mjs dev",
    "dev:frontend": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:go": "go test -race ./internal/...",
    "build": "npm run typecheck && vite build",
    "agent:win": "node scripts/build-agent.mjs windows amd64",
    "package:linux": "node scripts/package.mjs linux",
    "package:windows": "node scripts/package.mjs windows",
    "package": "node scripts/package.mjs",
    "build:android": "npm run typecheck && vite build --mode android",
    "package:android": "node scripts/package-android.mjs",
    "test:android-build": "node --test scripts/android-build.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "@wailsio/runtime": "3.0.0-beta.32"
  }
}
