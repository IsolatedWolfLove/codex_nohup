{
  "name": "nohop-codex",
  "version": "3.3.1",
  "private": true,
  "homepage": "https://github.com/IsolatedWolfLove/codex_nohup",
  "description": "Persistent SSH terminal sessions for Linux and Windows",
  "type": "module",
  "scripts": {
    "dev": "node scripts/wails.mjs dev",
    "dev:frontend": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:go": "go test -race ./internal/...",
    "build": "npm run typecheck && vite build",
    "agent:win": "node scripts/build-agent.mjs windows amd64",
    "package:linux": "node scripts/package.mjs linux",
    "package:windows": "node scripts/package.mjs windows",
    "package": "node scripts/package.mjs",
    "build:android": "npm run typecheck && vite build --mode android",
    "package:android": "node scripts/package-android.mjs",
    "test:android-build": "node --test scripts/android-build.test.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.67.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "@wailsio/runtime": "3.1.0",
    "pdfjs-dist": "6.5.438",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  }
}
